# Required: get a key from Google AI Studio
GEMINI_API_KEY=

# Gemini model
GEMINI_MODEL=gemini-2.5-flash-lite

# Put your BNS PDF here, or update this path
BNS_PDF_PATH=./data/BNS2023.pdf

# Folder for embeddings.npy + chunks.jsonl
INDEX_DIR=./bns_index

# Optional: reduce 429 rate-limit errors
# GEMINI_MAX_RETRIES=4
# GEMINI_MAX_EXCERPT_CHARS=3200
# GEMINI_MAX_HISTORY_MESSAGES=8

# Optional cross-encoder reranking (better relevance, slower, downloads another model)
# USE_CROSS_ENCODER=true
# CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# BI_ENCODER_POOL=24
# CROSS_ENCODER_MAX_PASSAGE_CHARS=2000
